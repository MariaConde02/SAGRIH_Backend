# Puerto del servidor backend (Render asigna PORT automáticamente)
PORT=3001
NODE_ENV=production

# Base de datos PostgreSQL (Neon u otro proveedor gestionado)
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"

# Seguridad y Autenticación JWT
JWT_SECRET="tu_clave_secreta_jwt_muy_segura"
JWT_EXPIRES_IN=8h

# CORS (Dominio del frontend en Vercel)
# Por defecto se permiten *.vercel.app y localhost en desarrollo
CORS_ORIGIN=https://sagrih-frontend.vercel.app

# Notificaciones por Email (EmailJS - Transaccional)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Notificaciones por Email (Nodemailer / SMTP - Cierre Diario)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAGRIH <no-reply@sagrih.com>"

# Bot de Telegram para Alertas Críticas (opcional)
TELEGRAM_BOT_TOKEN=
